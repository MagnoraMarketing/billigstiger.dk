# ---- Site ----
# Public URL. On Vercel this is detected automatically; set it when the domain billigestiger.dk is connected.
NEXT_PUBLIC_SITE_URL=
# Set to 1 to keep the site out of search engines (e.g. while running on demo data).
NEXT_PUBLIC_NOINDEX=1

# ---- Catalogue ----
# auto (default): demo products while data/products.json is empty, otherwise the imported catalogue.
# demo | file: force one or the other.
CATALOG_SOURCE=

# ---- Shop info (shown in footer, contact page, terms) ----
NEXT_PUBLIC_SHOP_EMAIL=kontakt@billigestiger.dk
NEXT_PUBLIC_SHOP_PHONE=
NEXT_PUBLIC_SHOP_CVR=
NEXT_PUBLIC_SHOP_ADDRESS=
NEXT_PUBLIC_SHIPPING_DKK=99
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD_DKK=999

# ---- Order delivery (server only, no database) ----
# At least one channel is required for orders to be accepted.
# 1) E-mail via Resend (https://resend.com) – sending domain must be verified there.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL="BilligeStiger.dk <ordre@billigestiger.dk>"
# 2) Webhook (Zapier / Make / Google Sheets / ERP) – receives the full order as JSON.
ORDER_WEBHOOK_URL=
ORDER_WEBHOOK_SECRET=
